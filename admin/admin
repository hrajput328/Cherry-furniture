<script>
// ── CONFIG ───────────────────────────────────────────────────────
const ADMIN_PW_KEY = 'cherry_admin_pw';
const DATA_KEY     = 'cherry_admin_data';

// ── HELPERS ──────────────────────────────────────────────────────
const el  = id => document.getElementById(id);
const v   = id => (el(id)?.value || '').trim();
const uid = () => Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const dateStr = d => d ? new Date(d).toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'}) : '—';
const slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');

function openModal(id)  { el(id).classList.add('open'); }
function closeModal(id) { el(id).classList.remove('open'); }

// ── DATA STORE ───────────────────────────────────────────────────
const DATA = {
  get: () => { try { return JSON.parse(localStorage.getItem(DATA_KEY)||'{}'); } catch { return {}; } },
  set: (key, val) => {
    const d = DATA.get(); d[key] = val;
    localStorage.setItem(DATA_KEY, JSON.stringify(d));
  },
  getKey: (key, def=[]) => { const d = DATA.get(); return d[key] ?? def; }
};

// ── AUTH ─────────────────────────────────────────────────────────
function doAdminLogin() {
  const pw = v('a-pass');
  const stored = localStorage.getItem(ADMIN_PW_KEY) || 'cherry2024';
  if (pw === stored) {
    localStorage.setItem('cherry_auth', '1'); // Persist login across refreshes
    el('login-screen').style.display = 'none';
    el('app').classList.add('visible');
    initAdmin();
  } else {
    el('a-err').style.display = 'block';
    setTimeout(() => el('a-err').style.display='none', 3000);
  }
}
el('a-pass').addEventListener('keydown', e => { if(e.key==='Enter') doAdminLogin(); });

function changeAdminPw() {
  const np = v('st-newpw'), cp = v('st-confpw');
  if (!np) { alert('Enter a new password.'); return; }
  if (np !== cp) { alert('Passwords do not match.'); return; }
  localStorage.setItem(ADMIN_PW_KEY, np);
  el('st-newpw').value=''; el('st-confpw').value='';
  alert('✅ Password updated!');
}

// ── NAVIGATION ───────────────────────────────────────────────────
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  el('page-'+name)?.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => {
    if (n.getAttribute('onclick')?.includes("'"+name+"'")) n.classList.add('active');
  });
  const renders = {
    dashboard: renderDashboard, catalogue: renderCatalogue, blog: renderBlog,
    gallery: renderGallery, media: renderMedia
  };
  if (renders[name]) renders[name]();
}

