// ── IMAGE HANDLING ────────────────────────────────────────────────
function handleImgSelect(input, previewId, dataId) {
  const file = input.files[0]; if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const preview = el(previewId); const dataEl = el(dataId);
    if(preview){ preview.src=e.target.result; preview.style.display='block'; }
    if(dataEl) dataEl.value = e.target.result;
  };
  reader.readAsDataURL(file);
}

function handleImgDrop(event, previewId, dataId) {
  event.preventDefault();
  const file = event.dataTransfer?.files?.[0]; if(!file||!file.type.startsWith('image/')) return;
  const fake = {files:[file], onchange:null};
  handleImgSelect({files:[file]}, previewId, dataId);
}

function previewImgFromUrl(inp, previewId) {
  const url = inp.value.trim();
  const preview = el(previewId);
  if(preview){ preview.src=url; preview.style.display=url?'block':'none'; }
}

// ── GITHUB ───────────────────────────────────────────────────────
function getGHConfig() {
  try { return JSON.parse(localStorage.getItem('cherry_gh')||'{}'); } catch { return {}; }
}

function saveGHSettings() {
  const cfg = {
    token: v('gh-token'), repo: v('gh-repo'),
    branch: v('gh-branch')||'main', folder: v('gh-folder')||'_data',
    savedAt: new Date().toISOString()
  };
  if(!cfg.token||!cfg.repo){ showGHAlert('Token and repository are both required.','red'); return; }
  localStorage.setItem('cherry_gh', JSON.stringify(cfg));
  // Inline saved confirmation (no disruptive alert)
  const info = el('gh-saved-info');
  if(info) { info.textContent = '✓ Saved at '+new Date().toLocaleTimeString('en-PK',{hour:'2-digit',minute:'2-digit'}); }
  showGHAlert('✅ GitHub settings saved to your browser. Click "Test Connection" to verify.','green');
  el('gh-status').className='gh-status connected';
  el('gh-status').textContent='● '+cfg.repo;
  logActivity('Updated GitHub settings for: '+cfg.repo);
}

function loadGHSettings() {
  const cfg = getGHConfig();
  if(el('gh-token')) el('gh-token').value = cfg.token||'';
  if(el('gh-repo'))  el('gh-repo').value  = cfg.repo||'';
  if(el('gh-branch')) el('gh-branch').value = cfg.branch||'main';
  if(el('gh-folder')) el('gh-folder').value = cfg.folder||'_data';
  if(cfg.savedAt && el('gh-saved-info')) {
    el('gh-saved-info').textContent = '✓ Last saved: '+dateStr(cfg.savedAt);
  }
  if(cfg.token && cfg.repo) {
    el('gh-status').className='gh-status connected';
    el('gh-status').textContent='● '+cfg.repo;
  }
}

async function testGitHub() {
  const cfg = getGHConfig();
  if(!cfg.token||!cfg.repo){ showGHAlert('Enter token and repository first.','red'); return; }
  const btn = el('gh-test-btn');
  btn.innerHTML = '<span class="spinner"></span>Testing...';
  btn.disabled = true;
  try {
    const res = await fetch(`https://api.github.com/repos/${cfg.repo}`, {
      headers: { Authorization: `token ${cfg.token}`, Accept: 'application/vnd.github.v3+json' }
    });
    const data = await res.json();
    if(res.ok) {
      showGHAlert(`✅ Connected! Repo: ${data.full_name} | Branch: ${cfg.branch} | Private: ${data.private}`, 'green');
      el('gh-status').className='gh-status connected';
      el('gh-status').textContent='● '+data.full_name;
      logActivity('GitHub connection verified: '+data.full_name);
    } else {
      showGHAlert('❌ Error: '+data.message, 'red');
      el('gh-status').className='gh-status error';
      el('gh-status').textContent='● Error';
    }
  } catch(e) {
    showGHAlert('❌ Network error. Check token and try again.', 'red');
  }
  btn.innerHTML = 'Test Connection'; btn.disabled=false;
}

function showGHAlert(msg, type) {
  const cls = type==='green'?'green':type==='blue'?'blue':'red';
  el('gh-alerts').innerHTML = `<div class="alert alert-${cls}">${msg}</div>`;
  setTimeout(()=>{ if(el('gh-alerts')) el('gh-alerts').innerHTML=''; }, 8000);
}

// ── PUBLISH TO GITHUB ─────────────────────────────────────────────
async function publishToGitHub() {
  const cfg = getGHConfig();
  if(!cfg.token||!cfg.repo) {
    alert('Connect GitHub first in Settings → GitHub Connect.');
    showPage('github'); return;
  }

  const commitMsg = v('commit-msg') || 'Updated content via Cherry Admin';
  const btn = el('publish-btn'); const spinner = el('publish-spinner');
  btn.disabled=true; spinner.style.display='inline-block';
  setProgress(10);

  // Build files to push
  const files = [
    { path: cfg.folder+'/catalogue.json', content: JSON.stringify(DATA.getKey('catalogue',[]), null, 2) },
    { path: cfg.folder+'/blog.json',      content: JSON.stringify(DATA.getKey('blog',[]), null, 2) },
    { path: cfg.folder+'/gallery.json',   content: JSON.stringify(DATA.getKey('gallery',[]).map(g=>({...g,data:undefined,url:g.url||''})), null, 2) },
    { path: cfg.folder+'/settings.json',  content: JSON.stringify(DATA.getKey('settings',{}), null, 2) },
    { path: cfg.folder+'/pages.json',     content: JSON.stringify(DATA.getKey('pages',{}), null, 2) },
  ];

  let pushed = 0;
  const headers = { Authorization:`token ${cfg.token}`, Accept:'application/vnd.github.v3+json', 'Content-Type':'application/json' };
  const apiBase = `https://api.github.com/repos/${cfg.repo}/contents/`;

  for (const file of files) {
    try {
      setProgress(10 + (pushed/files.length)*80);
      // Get existing file SHA (needed for updates)
      let sha = null;
      const getRes = await fetch(apiBase+file.path, { headers });
      if (getRes.ok) { const d=await getRes.json(); sha=d.sha; }
      // Push file
      const body = { message: commitMsg, content: btoa(unescape(encodeURIComponent(file.content))), branch: cfg.branch };
      if(sha) body.sha = sha;
      const putRes = await fetch(apiBase+file.path, { method:'PUT', headers, body:JSON.stringify(body) });
      if(!putRes.ok) { const e=await putRes.json(); throw new Error(e.message); }
      pushed++;
    } catch(err) {
      spinner.style.display='none'; btn.disabled=false; setProgress(0);
      alert('❌ Error publishing '+file.path+'\n'+err.message+'\n\nCheck your token has repo write access.');
      return;
    }
  }

  setProgress(100);
  localStorage.setItem('cherry_last_push', new Date().toISOString());
  logActivity('Published to GitHub: '+commitMsg);
  el('commit-msg').value='';
  pendingChanges=[];
  el('commit-bar').style.display='none';
  spinner.style.display='none'; btn.disabled=false;
  setTimeout(()=>setProgress(0), 2000);
  renderDashboard();
  alert(`✅ Published!\n${pushed} files pushed to ${cfg.repo}\nNetlify will rebuild your site in ~1 minute.\n\nLive at: cherryinterior.store`);
}

function setProgress(pct) {
  const f = el('progress-fill'); if(f) f.style.width=pct+'%';
}

// ── KEYBOARD ─────────────────────────────────────────────────────
document.addEventListener('keydown', e=>{
  if(e.key==='Escape') document.querySelectorAll('.modal-overlay.open').forEach(m=>m.classList.remove('open'));
});

// ── GITHUB TOKEN SHOW / HIDE ──────────────────────────────────────
function toggleTokenVisibility() {
  const inp = el('gh-token');
  const btn = el('token-toggle-btn');
  if (!inp || !btn) return;
  if (inp.type === 'password') {
    inp.type = 'text';
    btn.textContent = 'Hide';
  } else {
    inp.type = 'password';
    btn.textContent = 'Show';
  }
}

// ── CLEAR GITHUB CREDENTIALS ──────────────────────────────────────
function clearGHSettings() {
  if (!confirm('Remove saved GitHub credentials from this browser?\n\nYou will need to enter them again next time.')) return;
  localStorage.removeItem('cherry_gh');
  if(el('gh-token'))  { el('gh-token').value  = ''; el('gh-token').type='password'; }
  if(el('token-toggle-btn')) el('token-toggle-btn').textContent = 'Show';
  if(el('gh-repo'))   el('gh-repo').value   = '';
  if(el('gh-branch')) el('gh-branch').value = 'main';
  if(el('gh-folder')) el('gh-folder').value = '_data';
  if(el('gh-saved-info')) el('gh-saved-info').textContent = '';
  el('gh-status').className = 'gh-status';
  el('gh-status').textContent = '⚪ Not Connected';
  showGHAlert('GitHub credentials removed from this browser.', 'blue');
  logActivity('Cleared GitHub settings');
}

// ── AUTO-LOGIN + PRE-LOGIN STATUS ─────────────────────────────────
// Runs after DOM + all function definitions are ready.
document.addEventListener('DOMContentLoaded', () => {
  // Show GitHub connection status in topbar even before login
  const ghCfg = getGHConfig();
  if (ghCfg.token && ghCfg.repo) {
    el('gh-status').className = 'gh-status connected';
    el('gh-status').textContent = '● ' + ghCfg.repo;
  }

  // Auto-login if the user was previously authenticated in this browser.
  // The flag is cleared when they click Sign Out. Token is never exposed
  // in the source — it lives only in localStorage under 'cherry_gh'.
  if (localStorage.getItem('cherry_auth') === '1') {
    el('login-screen').style.display = 'none';
    el('app').classList.add('visible');
    initAdmin();
  }
});
</script>
