// ── DASHBOARD ────────────────────────────────────────────────────
function renderDashboard() {
  const products = DATA.getKey('catalogue', []);
  const posts    = DATA.getKey('blog', []);
  const gallery  = DATA.getKey('gallery', []);
  el('dash-catalogue-count').textContent = products.length;
  el('dash-blog-count').textContent      = posts.length;
  el('dash-gallery-count').textContent   = gallery.length;
  const lastPush = localStorage.getItem('cherry_last_push');
  el('dash-last-push').textContent = lastPush ? dateStr(lastPush) : 'Never';

  const activity = JSON.parse(localStorage.getItem('cherry_activity')||'[]');
  el('dash-activity').innerHTML = activity.length
    ? activity.slice(0,8).map(a=>`<div style="padding:.4rem 0;border-bottom:1px solid var(--border);font-size:11px;color:var(--muted)">${a.time} — ${a.msg}</div>`).join('')
    : '<div class="text-muted">No activity yet.</div>';

  // GitHub status badge
  const ghCfg = getGHConfig();
  if (ghCfg.token && ghCfg.repo) {
    el('gh-status').className = 'gh-status connected';
    el('gh-status').textContent = '● ' + ghCfg.repo;
  }
}

function logActivity(msg) {
  const activity = JSON.parse(localStorage.getItem('cherry_activity')||'[]');
  activity.unshift({ time: new Date().toLocaleTimeString('en-PK',{hour:'2-digit',minute:'2-digit'}), msg });
  localStorage.setItem('cherry_activity', JSON.stringify(activity.slice(0,20)));
}

// ── PENDING CHANGES ───────────────────────────────────────────────
let pendingChanges = [];

function markPending(description) {
  if (!pendingChanges.includes(description)) pendingChanges.push(description);
  el('commit-bar').style.display = 'flex';
  el('pending-changes-list').textContent = pendingChanges.join(' · ');
}

function discardPending() {
  pendingChanges = [];
  el('commit-bar').style.display = 'none';
}

// ── CATALOGUE ────────────────────────────────────────────────────
let catalogueFilter = { search: '', category: '' };

function renderCatalogue() {
  let items = DATA.getKey('catalogue', []);
  if (catalogueFilter.search) items = items.filter(p => (p.name+p.category+p.tags).toLowerCase().includes(catalogueFilter.search.toLowerCase()));
  if (catalogueFilter.category) items = items.filter(p => p.category === catalogueFilter.category);

  el('catalogue-grid').innerHTML = items.length ? items.map(p => `
    <div class="item-card">
      <div class="item-card-img">${p.imageUrl||p.imageData ? `<img src="${p.imageUrl||p.imageData}" alt="${p.name}"/>` : '🛋️'}</div>
      <div class="item-card-body">
        ${p.featured ? '<span class="item-card-badge">⭐ Featured</span>' : ''}
        <div class="item-card-title">${p.name}</div>
        <div class="item-card-meta">${p.category} ${p.price ? '· Rs. '+p.price : ''}</div>
        <div style="font-size:11px;color:var(--muted);line-height:1.5">${p.description?.slice(0,80)||''}${p.description?.length>80?'...':''}</div>
        <div class="item-card-actions">
          <span class="badge ${p.status==='available'?'badge-green':p.status==='order'?'badge-orange':'badge-gray'}">${p.status||'available'}</span>
          <div style="margin-left:auto;display:flex;gap:4px">
            <button class="btn btn-outline btn-sm" onclick="editProduct('${p.id}')">Edit</button>
            <button class="btn btn-sm" style="background:#ffebee;color:var(--red);border:1px solid #ffcdd2" onclick="deleteProduct('${p.id}')">Del</button>
          </div>
        </div>
      </div>
    </div>`).join('')
    : `<div class="empty-state" style="grid-column:1/-1"><div class="empty-icon">🛋️</div><h3>No Products Yet</h3><p>Add your furniture catalogue items to display them on your website.</p><button class="btn btn-red" onclick="openModal('product-modal');clearProductForm()" style="margin-top:1rem">+ Add First Product</button></div>`;
}

function filterCatalogue(val) { catalogueFilter.search=val; renderCatalogue(); }
function filterCatalogueCategory(val) { catalogueFilter.category=val; renderCatalogue(); }

function clearProductForm() {
  ['p-id','p-name','p-price','p-desc','p-material','p-dims','p-img-data','p-img-url','p-wa-text','p-tags'].forEach(id=>{const e=el(id);if(e)e.value='';});
  el('p-category').value='Bedroom'; el('p-status').value='available';
  el('p-featured').checked=false;
  el('p-img-preview').style.display='none'; el('p-img-preview').src='';
  el('product-modal-title').textContent='Add Product';
}

function saveProduct() {
  const name = v('p-name'); if(!name){alert('Product name required.');return;}
  const id = v('p-id') || uid();
  const products = DATA.getKey('catalogue', []);
  const idx = products.findIndex(p=>p.id===id);
  const obj = {
    id, name, category:v('p-category'), price:v('p-price'), description:v('p-desc'),
    material:v('p-material'), dimensions:v('p-dims'), status:v('p-status'),
    imageData:v('p-img-data'), imageUrl:v('p-img-url'),
    waText:v('p-wa-text')||'I am interested in '+name,
    tags:v('p-tags'), featured:el('p-featured').checked,
    updatedAt:new Date().toISOString()
  };
  if(idx>=0) products[idx]=obj; else products.push(obj);
  DATA.set('catalogue', products);
  closeModal('product-modal');
  renderCatalogue();
  markPending(idx>=0?'Updated: '+name:'Added: '+name);
  logActivity((idx>=0?'Updated':'Added')+' product: '+name);
}

function editProduct(id) {
  const p = DATA.getKey('catalogue',[]).find(x=>x.id===id); if(!p) return;
  clearProductForm();
  el('p-id').value=p.id; el('p-name').value=p.name||''; el('p-price').value=p.price||'';
  el('p-desc').value=p.description||''; el('p-material').value=p.material||'';
  el('p-dims').value=p.dimensions||''; el('p-status').value=p.status||'available';
  el('p-category').value=p.category||'Bedroom'; el('p-tags').value=p.tags||'';
  el('p-wa-text').value=p.waText||''; el('p-featured').checked=!!p.featured;
  el('p-img-url').value=p.imageUrl||'';
  if(p.imageData||p.imageUrl){el('p-img-preview').src=p.imageData||p.imageUrl;el('p-img-preview').style.display='block';}
  el('p-img-data').value=p.imageData||'';
  el('product-modal-title').textContent='Edit: '+p.name;
  openModal('product-modal');
}

function deleteProduct(id) {
  if(!confirm('Delete this product?')) return;
  const products = DATA.getKey('catalogue',[]).filter(p=>p.id!==id);
  DATA.set('catalogue', products);
  renderCatalogue();
  markPending('Deleted a product');
  logActivity('Deleted product');
}

