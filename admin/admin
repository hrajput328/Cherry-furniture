<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Cherry Admin — cherryinterior.store</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Josefin+Sans:wght@300;400;600&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet"/>
<style>
/* ── TOKENS ──────────────────────────────────────────────────── */
:root{
  --red:#C0392B;--dark:#1A0A08;--cream:#FAF6F0;--warm:#F0E8DC;
  --gold:#B8860B;--muted:#8B7355;--border:#DDD5C8;--green:#2E7D32;
  --blue:#1565C0;--orange:#E65100;
  --font-display:'Cormorant Garamond',serif;
  --font-ui:'Josefin Sans',sans-serif;
  --font-code:'Fira Code',monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--font-ui);background:var(--cream);color:var(--dark);min-height:100vh;overflow-x:hidden}

/* ── LOGIN ───────────────────────────────────────────────────── */
#login-screen{position:fixed;inset:0;background:var(--dark);display:flex;align-items:center;justify-content:center;z-index:999;flex-direction:column;gap:0}
.login-box{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);padding:3rem 2.5rem;width:400px;max-width:90vw}
.login-logo{font-family:var(--font-display);font-size:2.2rem;font-weight:700;color:var(--red);letter-spacing:-1px;text-align:center;margin-bottom:.25rem}
.login-sub{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,.35);text-align:center;margin-bottom:2rem}
.login-box label{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.4);display:block;margin-bottom:6px}
.login-box input{width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:white;padding:10px 14px;font-family:var(--font-ui);font-size:13px;outline:none;margin-bottom:1rem;transition:.2s}
.login-box input:focus{border-color:var(--red)}
.login-btn{width:100%;background:var(--red);color:white;border:none;padding:12px;font-family:var(--font-ui);font-size:11px;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:.2s}
.login-btn:hover{background:#A93226}
.login-err{color:#E74C3C;font-size:10px;margin-top:.5rem;display:none}

/* ── APP SHELL ───────────────────────────────────────────────── */
#app{display:none;min-height:100vh;flex-direction:column}
#app.visible{display:flex}

/* ── TOPBAR ──────────────────────────────────────────────────── */
.topbar{height:52px;background:var(--dark);display:flex;align-items:center;padding:0 1.5rem;gap:1rem;position:sticky;top:0;z-index:100;border-bottom:2px solid var(--red)}
.topbar-logo{font-family:var(--font-display);font-size:1.1rem;font-weight:700;color:var(--red);letter-spacing:-0.5px}
.topbar-logo span{color:rgba(255,255,255,.3);font-size:.7rem;font-family:var(--font-ui);letter-spacing:1px;font-weight:300;margin-left:6px}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:.75rem}
.gh-status{font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:4px 10px;border-radius:2px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5)}
.gh-status.connected{background:rgba(46,125,50,.25);color:#81C784}
.gh-status.error{background:rgba(192,57,43,.2);color:#EF9A9A}
.topbar-btn{background:none;border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.6);font-family:var(--font-ui);font-size:10px;letter-spacing:1px;padding:5px 12px;cursor:pointer;transition:.2s;text-transform:uppercase}
.topbar-btn:hover{border-color:var(--red);color:white}

/* ── LAYOUT ──────────────────────────────────────────────────── */
.layout{display:flex;flex:1;overflow:hidden}

/* ── SIDEBAR ─────────────────────────────────────────────────── */
.sidebar{width:220px;background:#140806;border-right:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;padding:1.5rem 0;overflow-y:auto;flex-shrink:0}
.sidebar-section{margin-bottom:1.5rem}
.sidebar-label{font-size:8px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.2);padding:0 1.2rem;margin-bottom:.5rem}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 1.2rem;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.45);cursor:pointer;transition:.15s;border-left:2px solid transparent}
.nav-item:hover{color:rgba(255,255,255,.8);background:rgba(255,255,255,.04)}
.nav-item.active{color:white;background:rgba(192,57,43,.15);border-left-color:var(--red)}
.nav-icon{width:14px;height:14px;opacity:.6;flex-shrink:0}
.nav-item.active .nav-icon{opacity:1}

/* ── MAIN ────────────────────────────────────────────────────── */
.main{flex:1;overflow-y:auto;background:var(--cream)}
.page{display:none;padding:2rem;min-height:calc(100vh - 52px)}
.page.active{display:block}

/* ── PAGE HEADER ─────────────────────────────────────────────── */
.page-hdr{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}
.page-hdr h1{font-family:var(--font-display);font-size:2rem;font-weight:600;color:var(--dark);letter-spacing:-0.5px}
.page-hdr small{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);display:block;margin-top:4px}

/* ── CARDS ───────────────────────────────────────────────────── */
.card{background:white;border:1px solid var(--border);margin-bottom:1rem}
.card-hdr{padding:1rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.card-hdr h3{font-family:var(--font-display);font-size:1.1rem;font-weight:600}
.card-body{padding:1.5rem}

/* ── BUTTONS ─────────────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-ui);font-size:9px;letter-spacing:2px;text-transform:uppercase;padding:8px 18px;border:none;cursor:pointer;transition:.2s;border-radius:0}
.btn-red{background:var(--red);color:white}
.btn-red:hover{background:#A93226}
.btn-dark{background:var(--dark);color:white}
.btn-dark:hover{background:#2c1410}
.btn-green{background:var(--green);color:white}
.btn-green:hover{background:#1B5E20}
.btn-outline{background:transparent;color:var(--dark);border:1px solid var(--border)}
.btn-outline:hover{border-color:var(--dark);background:var(--warm)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid transparent;font-size:9px;padding:6px 10px;letter-spacing:1px;text-transform:uppercase;cursor:pointer}
.btn-ghost:hover{color:var(--red)}
.btn-sm{padding:5px 12px;font-size:8px}

/* ── FORMS ───────────────────────────────────────────────────── */
.form-group{margin-bottom:1.2rem}
.form-group label{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:9px 12px;border:1px solid var(--border);font-family:var(--font-ui);font-size:12px;color:var(--dark);background:white;outline:none;transition:.2s;resize:vertical}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(192,57,43,.08)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem}

/* ── GRID LISTS ──────────────────────────────────────────────── */
.item-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;margin-top:1rem}
.item-card{background:white;border:1px solid var(--border);transition:.2s;position:relative}
.item-card:hover{border-color:var(--red);box-shadow:0 4px 20px rgba(192,57,43,.08)}
.item-card-img{width:100%;height:160px;object-fit:cover;background:#f5f0eb;display:flex;align-items:center;justify-content:center;color:var(--border);font-size:2rem}
.item-card-img img{width:100%;height:100%;object-fit:cover}
.item-card-body{padding:1rem}
.item-card-title{font-family:var(--font-display);font-size:1.1rem;font-weight:600;margin-bottom:.25rem}
.item-card-meta{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem}
.item-card-actions{display:flex;gap:6px;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border)}
.item-card-badge{font-size:8px;letter-spacing:1px;text-transform:uppercase;padding:3px 8px;background:var(--warm)}

/* ── TABLE ───────────────────────────────────────────────────── */
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:11px}
th{padding:8px 12px;text-align:left;background:var(--dark);color:rgba(255,255,255,.7);font-size:8px;letter-spacing:2px;text-transform:uppercase;font-weight:400}
td{padding:10px 12px;border-bottom:1px solid var(--border)}
tr:hover td{background:var(--warm)}

/* ── EDITOR ──────────────────────────────────────────────────── */
.editor-toolbar{display:flex;flex-wrap:wrap;gap:4px;padding:8px;background:var(--warm);border:1px solid var(--border);border-bottom:none}
.editor-toolbar button{background:white;border:1px solid var(--border);padding:4px 10px;font-family:var(--font-ui);font-size:9px;letter-spacing:1px;cursor:pointer;transition:.15s;text-transform:uppercase}
.editor-toolbar button:hover{background:var(--dark);color:white;border-color:var(--dark)}
.editor-area{width:100%;min-height:320px;padding:1rem;border:1px solid var(--border);font-family:var(--font-ui);font-size:13px;line-height:1.7;resize:vertical;outline:none;background:white}
.editor-area:focus{border-color:var(--red)}

/* ── COMMIT PANEL ────────────────────────────────────────────── */
.commit-bar{position:sticky;bottom:0;background:var(--dark);border-top:2px solid var(--red);padding:1rem 1.5rem;display:flex;align-items:center;gap:1rem;z-index:50}
.commit-input{flex:1;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:white;padding:8px 14px;font-family:var(--font-ui);font-size:11px;outline:none}
.commit-input:focus{border-color:var(--red)}
.commit-info{font-size:9px;letter-spacing:1px;color:rgba(255,255,255,.4);text-transform:uppercase}

/* ── PROGRESS ────────────────────────────────────────────────── */
.progress-bar{height:3px;background:rgba(255,255,255,.1);margin-bottom:0}
.progress-fill{height:100%;background:var(--red);width:0%;transition:.3s}

/* ── ALERTS ──────────────────────────────────────────────────── */
.alert{padding:.75rem 1rem;margin-bottom:1rem;font-size:11px;border-left:3px solid}
.alert-green{background:#E8F5E9;border-color:var(--green);color:#2E7D32}
.alert-red{background:#FFEBEE;border-color:var(--red);color:var(--red)}
.alert-blue{background:#E3F2FD;border-color:var(--blue);color:var(--blue)}

/* ── BADGE ───────────────────────────────────────────────────── */
.badge{display:inline-block;font-size:8px;letter-spacing:1px;text-transform:uppercase;padding:2px 8px}
.badge-green{background:#E8F5E9;color:#2E7D32}
.badge-orange{background:#FFF3E0;color:#E65100}
.badge-red{background:#FFEBEE;color:#C62828}
.badge-blue{background:#E3F2FD;color:#1565C0}
.badge-gray{background:#F5F5F5;color:#757575}

/* ── GITHUB SETUP ────────────────────────────────────────────── */
.setup-steps{counter-reset:steps}
.setup-step{counter-increment:steps;display:flex;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--border)}
.setup-step:last-child{border:none}
.step-num{width:32px;height:32px;background:var(--red);color:white;font-family:var(--font-display);font-size:1.1rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.step-body h4{font-family:var(--font-display);font-size:1.1rem;margin-bottom:.5rem}
.step-body p{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:.75rem}
.code-snippet{font-family:var(--font-code);font-size:11px;background:var(--dark);color:#A9DFBF;padding:.6rem 1rem;margin:.5rem 0;display:block;border-left:3px solid var(--red)}

/* ── MODAL ───────────────────────────────────────────────────── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(26,10,8,.75);z-index:500;align-items:center;justify-content:center;padding:1rem}
.modal-overlay.open{display:flex}
.modal{background:white;width:100%;max-width:680px;max-height:90vh;overflow-y:auto;display:flex;flex-direction:column}
.modal-lg{max-width:860px}
.modal-hdr{padding:1.25rem 1.5rem;background:var(--dark);display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.modal-hdr h3{font-family:var(--font-display);color:white;font-size:1.3rem;font-weight:600}
.modal-x{background:none;border:none;color:rgba(255,255,255,.5);font-size:1.2rem;cursor:pointer;padding:0 4px;line-height:1}
.modal-x:hover{color:white}
.modal-body{padding:1.5rem;flex:1}
.modal-footer{padding:1rem 1.5rem;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:.75rem;flex-shrink:0}

/* ── IMAGE UPLOAD ────────────────────────────────────────────── */
.img-upload-zone{border:2px dashed var(--border);padding:2rem;text-align:center;cursor:pointer;transition:.2s;background:var(--warm)}
.img-upload-zone:hover{border-color:var(--red);background:#fdf0ee}
.img-upload-zone.drag-over{border-color:var(--red);background:#fdf0ee}
.img-preview{width:100%;max-height:240px;object-fit:cover;display:none;margin-top:.75rem}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media(max-width:768px){
  .sidebar{display:none}
  .form-row,.form-row-3{grid-template-columns:1fr}
}

/* ── MISC ────────────────────────────────────────────────────── */
.sep{height:1px;background:var(--border);margin:1.5rem 0}
.text-muted{color:var(--muted);font-size:11px}
.text-red{color:var(--red)}
.fw-600{font-weight:600}
select option{font-family:var(--font-ui)}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}
.empty-state{text-align:center;padding:4rem 2rem;color:var(--muted)}
.empty-state .empty-icon{font-size:3rem;margin-bottom:1rem;opacity:.3}
.empty-state h3{font-family:var(--font-display);font-size:1.4rem;margin-bottom:.5rem;color:var(--dark)}
.empty-state p{font-size:12px;line-height:1.6}
</style>
</head>
<body>

<!-- ══ LOGIN ══════════════════════════════════════════════════════ -->
<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">Cherry</div>
    <div class="login-sub">Admin Panel — cherryinterior.store</div>
    <div>
      <label>Password</label>
      <input type="password" id="a-pass" placeholder="Enter admin password" onkeydown="if(event.key==='Enter')doAdminLogin()"/>
      <button class="login-btn" onclick="doAdminLogin()">Enter Panel →</button>
      <div class="login-err" id="a-err">Incorrect password.</div>
    </div>
  </div>
</div>

<!-- ══ APP ════════════════════════════════════════════════════════ -->
<div id="app">

  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-logo">Cherry <span>Admin Panel</span></div>
    <div class="progress-bar" style="position:absolute;bottom:0;left:0;right:0"><div class="progress-fill" id="progress-fill"></div></div>
    <div class="topbar-right">
      <span class="gh-status" id="gh-status">⚪ Not Connected</span>
      <button class="topbar-btn" onclick="showPage('github')">GitHub</button>
      <button class="topbar-btn" onclick="if(confirm('Sign out?')){localStorage.removeItem('cherry_auth');document.getElementById('app').classList.remove('visible');document.getElementById('login-screen').style.display='flex';}">Sign Out</button>
    </div>
  </div>

  <div class="layout">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-label">Content</div>
        <div class="nav-item active" onclick="showPage('dashboard')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Dashboard
        </div>
        <div class="nav-item" onclick="showPage('catalogue')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Catalogue
        </div>
        <div class="nav-item" onclick="showPage('blog')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Blog Posts
        </div>
        <div class="nav-item" onclick="showPage('gallery')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Gallery
        </div>
        <div class="nav-item" onclick="showPage('pages')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Pages
        </div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-label">Site</div>
        <div class="nav-item" onclick="showPage('media')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          Media Files
        </div>
        <div class="nav-item" onclick="showPage('settings')">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Site Settings
        </div>
        <div class="nav-item" onclick="showPage('github')">
          <svg class="nav-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          GitHub Connect
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="main">

      <!-- ── DASHBOARD ── -->
